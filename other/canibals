class Canibals:
    def __init__(self, state=None, size=6):
        """ Inicializes the environment """

        self.size = size

        # Number of missioners and canibals on the left and
        # if boat is on the left or not.
        self.state = state or (int(size/2), int(size/2), False)

    def __repr__(self):
        """ Print the current state of the enviroment """

        rc = '🧟'
        rm = '🧔'
        rb = '🛥️'

        print(self.state)
        output = list([rm] * self.state[M] + [' '] * (int(self.size/2) - self.state[M]))
        output += list([rc] * self.state[C] + [' '] * (int(self.size/2) - self.state[C]))
        output += ['🌊']
        output += list([rm] * (int(self.size/2) - self.state[M]) + [' '] * self.state[M])
        output += list([rc] * (int(self.size/2) - self.state[C]) + [' '] * self.state[C])

        return "".join(output)

    def do(self, m=0, c=0):
        """ Apply action that modifies the environment
        " moves m missioners and or c canibals
        " from one side to another.
        " Also moves the boat
        " @return true if valid action and state. False otherwise
        """

        if m == 0 and c == 0:
            return False

        new_m = self.state[M] - m
        if new_m < 0:
            return False
        self.state[M] = new_m
        
        new_c = self.state[C] - c
        if new_c < 0:
            return False
        self.state[C] = new_c

        self.state[B] = not self.state[B]
        return self.valid()

    def actions(self):
        # TODO adapt to size
        return ( (2, 0), (0, 2), (1, 1), (1, 0), (0, 1) )

    def valid(self):
        """ Checks if the state is valid """
        return self.state[M] >= self.state[C] 

    def final(self):
        """ Checks if the state is final """
        return self.state[M] == 0 and self.state[C] == 0


class AgentBF:

    def __init__(self, Environment):

        self.Environment = Environment
        self.visited = ()


    def search(self, queue):

        if not self.queue:
            # No solution found
            return []


        state, path = queue.pop()

        if state.final():
            # Reached a final state!
            return path + [state]

        for action in self.Environment.actions():
            new_state = self.Environment(state)
            
            if new_state.do(*action):
                # Breadth first, insert at the begining of the queue
                # so all the same level is done first before deeping
                # into the next level
                queue.insert(0, (state, queue))

                self.search(queue)



